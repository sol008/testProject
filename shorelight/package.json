{
  "name": "shorelight",
  "productName": "彼岸燈 Shorelight",
  "version": "1.0.0",
  "description": "彼岸燈 Shorelight — a Traditional-Chinese xianxia RPG set in ancient Taiwan",
  "main": "electron-main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.shorelight.game",
    "productName": "Shorelight",
    "copyright": "© Shorelight Team. Font: LXGW WenKai TC, SIL OFL 1.1",
    "directories": { "output": "dist" },
    "files": ["index.html", "electron-main.js", "package.json", "css/**", "js/**", "fonts/**", "LICENSES.txt"],
    "mac": {
      "category": "public.app-category.role-playing-games",
      "target": [{ "target": "dmg", "arch": ["universal"] }]
    }
  }
}
